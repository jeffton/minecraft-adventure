{
  "name": "minecraft-adventure-player",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs rpc.test.mjs skills.test.mjs",
    "test:sandbox": "node --test sandbox.test.mjs sandbox-access.test.mjs",
    "start": "node runtime.mjs",
    "check": "node --check runtime.mjs && node --check viewer.mjs && node --check reflexes.mjs && node --check observations.mjs && node --check agent.mjs",
    "test:agent": "node --test test/agent.test.mjs",
    "check:agent": "node --check agent.mjs"
  },
  "dependencies": {
    "@earendil-works/chord": "1.4.0",
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-durable": "1.4.0"
  }
}
